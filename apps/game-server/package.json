{
  "name": "@elysia/game-server",
  "version": "1.0.0",
  "description": "Server-authoritative backend, REST API and Socket.IO real-time multiplayer engine for Elysia no Densetsu",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@elysia/api-contracts": "workspace:*",
    "@elysia/game-data-schema": "workspace:*",
    "@elysia/game-types": "workspace:*",
    "@elysia/shared-utils": "workspace:*",
    "@elysia/validation": "workspace:*",
    "@elysia/vfx-engine": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
