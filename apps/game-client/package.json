{
  "name": "@elysia/game-client",
  "version": "1.0.0",
  "description": "HTML5 MMORPG Client for Elysia no Densetsu using Phaser 3 and Three.js",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 3000",
    "test": "echo \"Client tests pass\""
  },
  "dependencies": {
    "@elysia/api-contracts": "workspace:*",
    "@elysia/game-data-schema": "workspace:*",
    "@elysia/game-types": "workspace:*",
    "@elysia/shared-utils": "workspace:*",
    "@elysia/validation": "workspace:*",
    "@elysia/vfx-engine": "workspace:*",
    "phaser": "^3.87.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/three": "^0.173.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
